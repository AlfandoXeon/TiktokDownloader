<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary Meta Tags -->
  <title><%= title %></title>
  <meta name="title" content="<%= title %>" />
  <meta name="description" content="Free online TikTok video and photo carousel downloader. Save videos without watermark in HD, download slides as ZIP, or extract MP3 audio." />
  <meta name="keywords" content="tiktok downloader, download tiktok video, tiktok video no watermark, tiktok photo carousel download, tiktok zip download, tiktok mp3 audio extractor, free tiktok downloader" />
  <meta name="author" content="AlfandoXeon" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow" />
  <meta name="theme-color" content="#09090b" />
  <meta name="color-scheme" content="dark" />
  
  <!-- Canonical URL -->
  <link rel="canonical" href="<%= siteUrl %>/" />

  <!-- Google Site Verification -->
  <meta name="google-site-verification" content="<%= typeof googleSiteVerification !== 'undefined' && googleSiteVerification ? googleSiteVerification : 'B1dVLABSRdjLxotVaRcQUIW8-vHcyDlxpkMMMNMiQSg' %>" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= siteUrl %>/" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="Free online TikTok video and photo carousel downloader. Save videos without watermark in HD, download slides as ZIP, or extract MP3 audio." />
  <meta property="og:image" content="<%= siteUrl %>/og-image.png" />
  <meta property="og:image:secure_url" content="<%= siteUrl %>/og-image.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="TikTok Downloader - Download Videos & Photos (No Watermark)" />
  <meta property="og:site_name" content="TikTok Downloader" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="<%= siteUrl %>/" />
  <meta name="twitter:title" content="<%= title %>" />
  <meta name="twitter:description" content="Free online TikTok video and photo carousel downloader. Save videos without watermark in HD, download slides as ZIP, or extract MP3 audio." />
  <meta name="twitter:image" content="<%= siteUrl %>/og-image.png" />
  <meta name="twitter:image:alt" content="TikTok Downloader" />

  <!-- Favicon & Mobile Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Stylesheets & Scripts -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Structured Data / JSON-LD for Search Rich Snippets -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "@id": "<%= siteUrl %>/#webapp",
        "name": "TikTok Downloader",
        "url": "<%= siteUrl %>/",
        "description": "Download TikTok videos without watermark, save photo carousels in ZIP, and convert to MP3 audio for free.",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript. Requires HTML5.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "author": {
          "@type": "Person",
          "name": "AlfandoXeon"
        }
      },
      {
        "@type": "HowTo",
        "@id": "<%= siteUrl %>/#howto",
        "name": "How to Download TikTok Videos Without Watermark",
        "description": "Simple guide on downloading TikTok videos and photo slide carousels in original high quality.",
        "step": [
          {
            "@type": "HowToStep",
            "position": 1,
            "name": "Copy Video Link",
            "text": "Open TikTok in your app or browser, find the video or photo slide you want to download, tap Share, and select Copy Link."
          },
          {
            "@type": "HowToStep",
            "position": 2,
            "name": "Paste URL",
            "text": "Return to this page, paste the copied TikTok link into the input field above, and click Download."
          },
          {
            "@type": "HowToStep",
            "position": 3,
            "name": "Save Media",
            "text": "Select your preferred download format: Video No Watermark (SD or HD), Photo Slides (ZIP), or Audio MP3."
          }
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "<%= siteUrl %>/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is this TikTok downloader free to use?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. The service is completely free with no usage limits, subscription fees, or account registrations required."
            }
          },
          {
            "@type": "Question",
            "name": "How do I download TikTok videos without a watermark?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Copy the video link from TikTok, paste it into the search input on this page, click Download, and choose 'Download Video (No Watermark)'."
            }
          },
          {
            "@type": "Question",
            "name": "Can I download TikTok photo carousels (slides)?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. You can preview all photo slides, download individual photos in full resolution, or bundle all photos together into a single ZIP archive."
            }
          },
          {
            "@type": "Question",
            "name": "Where are downloaded files saved?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Downloaded files are automatically saved to your browser's default download directory, such as the Downloads folder on Windows, Mac, and Android, or the Files app on iOS."
            }
          },
          {
            "@type": "Question",
            "name": "Does this service store my download history or media files?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Media streams are piped directly from TikTok's servers to your browser. We do not store your files, links, or personal information on our servers."
            }
          }
        ]
      }
    ]
  }
  </script>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col antialiased selection:bg-zinc-700 selection:text-white">

  <!-- Header -->
  <header class="border-b border-zinc-800/80 bg-zinc-900/50 backdrop-blur sticky top-0 z-30">
    <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center text-white group-hover:border-zinc-500 transition">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.89 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.52a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3 15.67 6.34 6.34 0 0 0 9.34 22a6.34 6.34 0 0 0 6.34-6.33V9.05a8.16 8.16 0 0 0 4.91 1.64V7.24a4.86 4.86 0 0 1-1-.55z"/>
          </svg>
        </div>
        <span class="font-semibold text-base tracking-tight text-white">TikTok Downloader</span>
      </a>
      <span class="text-xs text-zinc-400 bg-zinc-900 border border-zinc-800 px-3 py-1 rounded-full">
        Videos & Photo Carousels
      </span>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-3xl w-full mx-auto px-4 py-12 sm:py-16">
    <!-- Hero Section -->
    <section class="text-center mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-3">
        Download TikTok Videos & Photos
      </h1>
      <p class="text-zinc-400 text-sm sm:text-base max-w-md mx-auto">
        Save videos without watermark in high quality, download photo slide carousels (batch ZIP or single photos), or extract MP3 audio.
      </p>
    </section>

    <!-- Input Form Section -->
    <section class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-3 sm:p-4 shadow-xl mb-8">
      <form id="extractForm" class="flex flex-col sm:flex-row gap-2.5">
        <div class="relative flex-1">
          <input
            type="url"
            id="tiktokUrlInput"
            placeholder="Paste TikTok video or photo carousel link here..."
            required
            class="w-full bg-zinc-950 border border-zinc-800 focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 rounded-xl pl-4 pr-20 py-3.5 text-sm text-white placeholder-zinc-500 outline-none transition"
          />
          <button
            type="button"
            id="pasteBtn"
            class="absolute right-2 top-1/2 -translate-y-1/2 text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white px-3 py-1.5 rounded-lg border border-zinc-700/80 transition"
          >
            Paste
          </button>
        </div>
        <button
          type="submit"
          id="submitBtn"
          class="bg-white hover:bg-zinc-200 text-zinc-950 font-semibold px-6 py-3.5 rounded-xl transition flex items-center justify-center gap-2 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed shrink-0"
        >
          <span id="submitBtnText">Download</span>
          <svg id="submitSpinner" class="hidden w-4 h-4 animate-spin text-zinc-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </button>
      </form>

      <!-- Alert Box -->
      <div id="alertBox" class="hidden mt-3 p-3.5 rounded-xl border text-sm flex items-start gap-2.5"></div>
    </section>

    <!-- Result Card -->
    <section id="resultContainer" class="hidden bg-zinc-900/60 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-xl">
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 p-5 sm:p-6">
        
        <!-- Media Preview (Left Column) -->
        <div class="sm:col-span-5 flex flex-col items-center">
          
          <!-- 1. Video Preview Container -->
          <div id="videoPreviewWrapper" class="w-full max-w-[240px] aspect-[9/16] rounded-xl overflow-hidden bg-black border border-zinc-800">
            <video
              id="videoPreview"
              controls
              playsinline
              poster=""
              class="w-full h-full object-cover"
            ></video>
          </div>

          <!-- 2. Photo Carousel Preview Container -->
          <div id="photoCarouselWrapper" class="hidden w-full max-w-[260px] flex flex-col items-center gap-3">
            <div class="relative w-full aspect-[9/16] sm:aspect-[3/4] rounded-xl overflow-hidden bg-zinc-950 border border-zinc-800 flex items-center justify-center">
              <img
                id="carouselMainImg"
                src=""
                alt="TikTok Photo Preview"
                class="w-full h-full object-contain"
              />
              <!-- Navigation Buttons -->
              <button
                type="button"
                id="carouselPrevBtn"
                class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-zinc-900/80 hover:bg-zinc-800 text-white flex items-center justify-center border border-zinc-700/80 backdrop-blur transition select-none shadow"
                title="Previous Photo"
              >
                &#10094;
              </button>
              <button
                type="button"
                id="carouselNextBtn"
                class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-zinc-900/80 hover:bg-zinc-800 text-white flex items-center justify-center border border-zinc-700/80 backdrop-blur transition select-none shadow"
                title="Next Photo"
              >
                &#10095;
              </button>
              <!-- Slide Counter -->
              <div class="absolute bottom-2 left-1/2 -translate-x-1/2 bg-zinc-900/90 text-white text-[11px] font-mono px-2.5 py-0.5 rounded-full border border-zinc-700/60 backdrop-blur">
                <span id="carouselCurrentIndex">1</span> / <span id="carouselTotalCount">1</span>
              </div>
            </div>

            <!-- Download Active Photo Shortcut -->
            <a
              id="btnDownloadCurrentPhoto"
              href="#"
              class="w-full text-xs font-medium py-2.5 px-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700/80 transition flex items-center justify-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              <span>Download This Photo (HD)</span>
            </a>
          </div>

        </div>

        <!-- Media Information & Actions (Right Column) -->
        <div class="sm:col-span-7 flex flex-col justify-between">
          <div>
            <!-- Creator Info -->
            <div class="flex items-center gap-3 mb-4 pb-4 border-b border-zinc-800">
              <img
                id="authorAvatar"
                src=""
                alt="Avatar"
                class="w-11 h-11 rounded-full object-cover bg-zinc-800 border border-zinc-700"
              />
              <div class="min-w-0 flex-1">
                <h3 id="authorNickname" class="font-semibold text-white text-sm truncate"></h3>
                <p id="authorUsername" class="text-xs text-zinc-400 truncate"></p>
              </div>
              <span id="mediaBadge" class="text-xs bg-zinc-800 text-zinc-300 px-2.5 py-1 rounded-md border border-zinc-700/80 font-mono"></span>
            </div>

            <!-- Description -->
            <p id="videoTitle" class="text-sm text-zinc-300 mb-5 line-clamp-3 leading-relaxed"></p>

            <!-- Metrics -->
            <div class="grid grid-cols-4 gap-2 mb-6 text-center">
              <div class="bg-zinc-950/60 border border-zinc-800/80 py-2 px-1 rounded-xl">
                <span class="block text-[11px] text-zinc-400">Views</span>
                <span id="statPlays" class="font-semibold text-sm text-white">0</span>
              </div>
              <div class="bg-zinc-950/60 border border-zinc-800/80 py-2 px-1 rounded-xl">
                <span class="block text-[11px] text-zinc-400">Likes</span>
                <span id="statLikes" class="font-semibold text-sm text-white">0</span>
              </div>
              <div class="bg-zinc-950/60 border border-zinc-800/80 py-2 px-1 rounded-xl">
                <span class="block text-[11px] text-zinc-400">Comments</span>
                <span id="statComments" class="font-semibold text-sm text-white">0</span>
              </div>
              <div class="bg-zinc-950/60 border border-zinc-800/80 py-2 px-1 rounded-xl">
                <span class="block text-[11px] text-zinc-400">Shares</span>
                <span id="statShares" class="font-semibold text-sm text-white">0</span>
              </div>
            </div>
          </div>

          <!-- Video Download Action Buttons -->
          <div id="videoActions" class="space-y-2.5">
            <a
              id="btnDownloadSd"
              href="#"
              class="w-full py-3 px-4 rounded-xl bg-white hover:bg-zinc-200 text-zinc-950 font-semibold text-sm flex items-center justify-center gap-2 transition"
            >
              <span>Download Video (No Watermark)</span>
            </a>

            <a
              id="btnDownloadHd"
              href="#"
              class="w-full py-3 px-4 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white border border-zinc-700 text-sm font-medium flex items-center justify-center gap-2 transition"
            >
              <span>Download Video (HD)</span>
            </a>

            <a
              id="btnDownloadMp3"
              href="#"
              class="w-full py-3 px-4 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white border border-zinc-700 text-sm font-medium flex items-center justify-center gap-2 transition"
            >
              <span>Download Audio (MP3)</span>
            </a>
          </div>

          <!-- Photo Carousel Action Buttons & Selection Grid -->
          <div id="photoActions" class="hidden space-y-3.5">
            <!-- Selection Toolbar -->
            <div class="flex items-center justify-between text-xs text-zinc-300 bg-zinc-950/70 p-2.5 rounded-xl border border-zinc-800">
              <label class="flex items-center gap-2 cursor-pointer select-none font-medium">
                <input
                  type="checkbox"
                  id="selectAllCheckbox"
                  class="w-4 h-4 rounded bg-zinc-800 border-zinc-700 text-zinc-300 accent-white cursor-pointer"
                  checked
                />
                <span>Select All Photos</span>
              </label>
              <span id="photoSelectionStatus" class="font-mono text-zinc-400"></span>
            </div>

            <!-- Thumbnail Grid with Checkboxes -->
            <div
              id="photoGrid"
              class="grid grid-cols-3 sm:grid-cols-4 gap-2 max-h-48 overflow-y-auto p-2 rounded-xl bg-zinc-950/40 border border-zinc-800/60"
            >
              <!-- Populated dynamically by JavaScript -->
            </div>

            <!-- Batch Download Action Buttons -->
            <div class="space-y-2 pt-1">
              <button
                type="button"
                id="btnDownloadSelectedZip"
                class="w-full py-3 px-4 rounded-xl bg-white hover:bg-zinc-200 text-zinc-950 font-semibold text-sm flex items-center justify-center gap-2 transition disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                <span id="btnDownloadSelectedText">Download Selected Photos (ZIP)</span>
              </button>

              <div class="grid grid-cols-2 gap-2">
                <a
                  id="btnDownloadAllZip"
                  href="#"
                  class="py-2.5 px-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white border border-zinc-700 text-xs font-medium flex items-center justify-center gap-1.5 transition text-center"
                >
                  <span>Download All (ZIP)</span>
                </a>

                <a
                  id="btnDownloadPhotoAudio"
                  href="#"
                  class="py-2.5 px-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white border border-zinc-700 text-xs font-medium flex items-center justify-center gap-1.5 transition text-center"
                >
                  <span>Download Audio (MP3)</span>
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="mt-14 pt-10 border-t border-zinc-800/60">
      <div class="mb-6">
        <h2 class="text-lg font-semibold tracking-tight text-white mb-1">
          How to Download TikTok Videos
        </h2>
        <p class="text-xs text-zinc-400">
          Save watermark-free videos, photo slide carousels, and audio in three simple steps.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Step 1 -->
        <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
          <div>
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-zinc-800 text-zinc-300 font-mono text-xs font-semibold mb-3 border border-zinc-700/60">
              1
            </span>
            <h3 class="text-sm font-medium text-white mb-1">Copy Link</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Open TikTok, choose any video or photo carousel, tap <strong>Share</strong>, and select <strong>Copy Link</strong>.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
          <div>
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-zinc-800 text-zinc-300 font-mono text-xs font-semibold mb-3 border border-zinc-700/60">
              2
            </span>
            <h3 class="text-sm font-medium text-white mb-1">Paste URL</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Paste the copied URL into the search box above and click the <strong>Download</strong> button.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
          <div>
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-zinc-800 text-zinc-300 font-mono text-xs font-semibold mb-3 border border-zinc-700/60">
              3
            </span>
            <h3 class="text-sm font-medium text-white mb-1">Save Media</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Choose your format: Video without watermark (SD/HD), single or batch photo slides (ZIP), or MP3 audio.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Features Section -->
    <section class="mt-12">
      <div class="mb-6">
        <h2 class="text-lg font-semibold tracking-tight text-white mb-1">
          Features
        </h2>
        <p class="text-xs text-zinc-400">
          Clean, fast, and lightweight media extractor without bloated dependencies.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <!-- Feature 1 -->
        <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-lg bg-zinc-800 border border-zinc-700/60 flex items-center justify-center text-zinc-300 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-medium text-white mb-1">Watermark-Free HD Video</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Download original TikTok videos without floating watermarks or logos, up to full high definition.
            </p>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-lg bg-zinc-800 border border-zinc-700/60 flex items-center justify-center text-zinc-300 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-medium text-white mb-1">Photo Carousels &amp; ZIP Archive</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Preview slide photos in an interactive carousel and download selected images or all photos in one ZIP package.
            </p>
          </div>
        </div>

        <!-- Feature 3 -->
